using Gtk 4.0;
using Adw 1;

template $BlinkPreferencesDialog: Adw.PreferencesDialog {
  search-enabled: false;

  Adw.PreferencesPage {
    Adw.PreferencesGroup {
      title: _("Appearance");

      Adw.ComboRow style_row {
        title: _("Style");

        model: Gtk.StringList {
          strings [
            _("System"),
            _("Light"),
            _("Dark"),
          ]
        };
      }

      Adw.ComboRow width_row {
        title: _("Content Width");
        subtitle: _("The widest the editor and the preview get");
      }

      Adw.ActionRow {
        title: _("Text Font");
        subtitle: _("The preview and exported documents");
        activatable-widget: text_font_button;

        [suffix]
        Gtk.Button text_font_reset {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use System Font");
          valign: center;

          styles [
            "flat",
          ]
        }

        [suffix]
        Gtk.FontDialogButton text_font_button {
          level: family;
          use-font: true;
          valign: center;

          dialog: Gtk.FontDialog {
            title: _("Text Font");
          };
        }
      }

      Adw.ActionRow {
        title: _("Monospace Font");
        subtitle: _("The editor and code");
        activatable-widget: monospace_font_button;

        [suffix]
        Gtk.Button monospace_font_reset {
          icon-name: "edit-undo-symbolic";
          tooltip-text: _("Use System Font");
          valign: center;

          styles [
            "flat",
          ]
        }

        [suffix]
        Gtk.FontDialogButton monospace_font_button {
          level: family;
          use-font: true;
          valign: center;

          dialog: Gtk.FontDialog {
            title: _("Monospace Font");
          };
        }
      }
    }

    Adw.PreferencesGroup {
      title: _("Editor");

      Adw.SwitchRow wrap_row {
        title: _("Wrap Text");
      }

      Adw.SwitchRow line_numbers_row {
        title: _("Line Numbers");
      }

      Adw.SwitchRow current_line_row {
        title: _("Highlight Current Line");
      }

      Adw.SwitchRow alternate_lines_row {
        title: _("Shade Alternate Lines");
      }

      Adw.SpinRow tab_width_row {
        title: _("Tab Width");

        adjustment: Gtk.Adjustment {
          lower: 1;
          upper: 16;
          step-increment: 1;
          page-increment: 4;
        };
      }
    }
  }
}
