using Gtk 4.0;
using Adw 1;
using GtkSource 5;

menu primary_menu {
  section {
    item {
      label: _("_New Document");
      action: "win.new";
    }

    submenu recent_menu {
      label: _("Open _Recent");
    }

    item {
      label: _("Save _As…");
      action: "win.save-as";
    }

    item {
      label: _("_Export as HTML…");
      action: "win.export-html";
    }
  }

  section {
    item {
      label: _("_Focus Mode");
      action: "win.focus-mode";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Blink");
      action: "app.about";
    }
  }
}

template $BlinkWindow: Adw.ApplicationWindow {
  title: _("Untitled Document");
  width-request: 360;
  height-request: 294;

  // Two panes side by side are unusable below this width: the split view gives way to
  // the pane it was opened from, and cannot be picked again until the window is wider.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split_toggle.enabled: false;
      // The content is narrower than any of the widths anyway.
      width_button.visible: false;
    }

    apply => $on_narrow() swapped;
  }

  content: Gtk.Overlay drop_area {
    child: Adw.ToastOverlay toast_overlay {
      child: Adw.ToolbarView toolbar_view {
        reveal-top-bars: bind template.focus-mode inverted;
        reveal-bottom-bars: bind template.focus-mode inverted;

        [top]
        Adw.HeaderBar {
          [start]
          Gtk.Button {
            icon-name: "document-open-symbolic";
            tooltip-text: _("Open Document");
            action-name: "win.open";
          }

          [start]
          Gtk.Button {
            icon-name: "document-save-symbolic";
            tooltip-text: _("Save Document");
            action-name: "win.save";
          }

          title-widget: Adw.WindowTitle window_title {
            title: _("Untitled Document");
          };

          [end]
          Gtk.MenuButton {
            icon-name: "open-menu-symbolic";
            tooltip-text: _("Main Menu");
            menu-model: primary_menu;
            primary: true;
          }

          [end]
          Adw.ToggleGroup view_toggles {
            notify::active-name => $on_view_toggled() swapped;

            Adw.Toggle {
              name: "edit";
              icon-name: "document-edit-symbolic";
              tooltip: _("Edit Document");
            }

            Adw.Toggle {
              name: "preview";
              icon-name: "view-reveal-symbolic";
              tooltip: _("Preview Document");
            }

            Adw.Toggle split_toggle {
              name: "split";
              icon-name: "view-dual-symbolic";
              tooltip: _("Split View");
            }
          }

          [end]
          Gtk.MenuButton width_button {
            icon-name: "format-justify-fill-symbolic";
            tooltip-text: _("Content Width");
          }
        }

        [top]
        Gtk.Box search_bar {
          orientation: vertical;
          spacing: 6;
          margin-start: 6;
          margin-end: 6;
          margin-top: 6;
          margin-bottom: 6;
          visible: false;

          styles [
            "toolbar",
          ]

          Gtk.Box {
            spacing: 6;

            Gtk.SearchEntry search_entry {
              hexpand: true;
              width-chars: 24;
              placeholder-text: _("Search");
              search-changed => $on_search_changed() swapped;
              activate => $on_search_next() swapped;
              stop-search => $on_search_closed() swapped;
            }

            Gtk.Label search_status {
              xalign: 0;
              ellipsize: end;
              max-width-chars: 24;
              width-chars: 16;
            }

            Gtk.Button {
              icon-name: "go-up-symbolic";
              tooltip-text: _("Previous Match");
              action-name: "win.find-previous";
            }

            Gtk.Button {
              icon-name: "go-down-symbolic";
              tooltip-text: _("Next Match");
              action-name: "win.find-next";
            }

            Gtk.Button {
              icon-name: "window-close-symbolic";
              tooltip-text: _("Close Search");
              clicked => $on_search_closed() swapped;
            }
          }

          Gtk.Box replace_row {
            spacing: 6;

            Gtk.Entry replace_entry {
              hexpand: true;
              width-chars: 24;
              placeholder-text: _("Replace");
              activate => $on_replace() swapped;
            }

            Gtk.Button replace_button {
              label: _("Replace");
              tooltip-text: _("Replace Match");
              clicked => $on_replace() swapped;
            }

            Gtk.Button replace_all_button {
              label: _("Replace All");
              tooltip-text: _("Replace All Matches");
              action-name: "win.replace-all";
            }
          }
        }

        [top]
        Adw.Banner monitor_banner {
          title: _("Changes other programs make to this file will not be noticed until the next save");
        }

        content: Gtk.Box {
          homogeneous: true;

          Gtk.ScrolledWindow edit_scroll {
            hexpand: true;
            hscrollbar-policy: never;

            // ClampScrollable rather than Clamp, so the scrolled window scrolls the view
            // through its own scrollable interface. A plain Clamp is not scrollable, and
            // the scrolled window would scroll the whole view to its top on every click.
            child: Adw.ClampScrollable {
              maximum-size: bind template.content-width;

              child: $BlinkEditorView edit_view {
                monospace: true;
                wrap-mode: word;
                left-margin: 32;
                right-margin: 32;
                top-margin: 32;
                bottom-margin: 32;
                pixels-above-lines: 4;
                pixels-below-lines: 4;
                margin-top: 12;
                margin-bottom: 12;

                buffer: GtkSource.Buffer edit_buffer {
                  changed => $on_buffer_changed() swapped;
                  modified-changed => $on_modified_changed() swapped;
                };

                styles [
                  "editor-view",
                ]
              };
            };
          }

          // External rather than never: tables, code blocks and images are sized from
          // this window's page width, and with never the viewport could not become
          // narrower than what it sizes, so the window could not shrink once such a
          // document is open. External allows that without a scrollbar the content
          // never needs.
          Gtk.ScrolledWindow preview_scroll {
            hexpand: true;
            hscrollbar-policy: external;
            visible: false;

            child: Adw.ClampScrollable {
              maximum-size: bind template.content-width;

              // Read-only but focusable, so its text and tables can be selected and
              // copied.
              child: Gtk.TextView preview_view {
                editable: false;
                cursor-visible: false;
                wrap-mode: word;
                top-margin: 32;
                bottom-margin: 32;
                pixels-above-lines: 4;
                pixels-below-lines: 4;
                // Wrapped lines of a paragraph spaced like separate lines.
                pixels-inside-wrap: 8;

                styles [
                  "transparent-bg",
                  "preview-view",
                ]
              };
            };
          }
        };

        [bottom]
        Gtk.Box {
          styles [
            "toolbar",
          ]

          Gtk.Label status_label {
            hexpand: true;
            halign: end;
            margin-top: 4;
            margin-bottom: 4;
            margin-end: 12;

            styles [
              "dim-label",
              "numeric",
            ]
          }
        }
      };
    };

    [overlay]
    Gtk.Box drop_overlay {
      visible: false;
      can-target: false;

      styles [
        "drop-overlay",
      ]

      Adw.StatusPage {
        hexpand: true;
        icon-name: "document-open-symbolic";
        title: _("Drop Markdown file to open");
      }
    }
  };
}
