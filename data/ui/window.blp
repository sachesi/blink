using Gtk 4.0;
using Adw 1;

menu primary_menu {
  section {
    item {
      label: _("_New Document");
      action: "win.new";
    }

    item {
      label: _("Open _Folder…");
      action: "win.open-folder";
    }

    submenu recent_menu {
      label: _("Open _Recent");
    }

    item {
      label: _("Save _As…");
      action: "win.save-as";
    }

    item {
      label: _("_Export as HTML…");
      action: "win.export-html";
    }

    item {
      label: _("Export as _PDF…");
      action: "win.export-pdf";
    }
  }

  section {
    item {
      label: _("_Focus Mode");
      action: "win.focus-mode";
    }
  }

  section {
    item {
      label: _("_Preferences");
      action: "app.preferences";
    }

    item {
      label: _("_Keyboard Shortcuts");
      action: "app.shortcuts";
    }

    item {
      label: _("_About Blink");
      action: "app.about";
    }
  }
}

menu tab_menu {
  section {
    item {
      label: _("Move to _New Window");
      action: "win.tab-to-new-window";
    }
  }

  section {
    item {
      label: _("_Close");
      action: "win.tab-close";
    }
  }
}

template $BlinkWindow: Adw.ApplicationWindow {
  title: _("Untitled Document");
  width-request: 360;
  height-request: 294;

  // Two panes side by side are unusable below this width: the split view gives way to
  // the pane it was opened from, and cannot be picked again until the window is wider.
  Adw.Breakpoint {
    condition ("max-width: 700sp")

    setters {
      split_toggle.enabled: false;
      bottom_split_toggle.enabled: false;
      // The content is narrower than any of the widths anyway.
      width_button.visible: false;
      // Too narrow for more than a few tabs side by side: the tabs are shown in the
      // overview instead.
      tab_bar.visible: false;
      tab_button.visible: true;
      // Beside the title there is no room for the view toggles as well.
      view_toggles.visible: false;
      view_bar.visible: true;
      split_view.collapsed: true;
    }

    apply => $on_narrow() swapped;
    unapply => $on_wide() swapped;
  }

  content: Gtk.Overlay drop_area {
    child: Adw.ToastOverlay toast_overlay {
      child: Adw.TabOverview {
        view: tab_view;
        enable-new-tab: true;
        create-tab => $on_create_tab() swapped;

        child: Adw.OverlaySplitView split_view {
          show-sidebar: bind template.show-sidebar bidirectional;

          // The Markdown files of the folder the window shows, while it shows one.
          sidebar: Adw.ToolbarView {
            [top]
            Adw.HeaderBar {
              title-widget: Adw.WindowTitle folder_title {};

              [end]
              Gtk.ToggleButton {
                icon-name: "system-search-symbolic";
                tooltip-text: _("Search Files");
                active: bind folder_search_bar.search-mode-enabled bidirectional;
              }
            }

            // Opens as well when a name is typed in the list.
            [top]
            Gtk.SearchBar folder_search_bar {
              key-capture-widget: folder_list;

              child: Gtk.SearchEntry folder_search {
                placeholder-text: _("Search Files");
                search-changed => $on_folder_search_changed() swapped;
                activate => $on_folder_search_activated() swapped;
              };
            }

            content: Gtk.Stack folder_stack {
              Gtk.StackPage {
                name: "files";

                child: Gtk.ScrolledWindow {
                  hscrollbar-policy: never;

                  child: Gtk.ListView folder_list {
                    activate => $on_folder_row_activated() swapped;

                    styles [
                      "navigation-sidebar",
                    ]
                  };
                };
              }

              Gtk.StackPage {
                name: "empty";

                child: Adw.StatusPage {
                  icon-name: "folder-symbolic";
                  title: _("No Markdown Files");
                  description: _("There are no Markdown files in this folder or the folders in it");

                  styles [
                    "compact",
                  ]
                };
              }

              Gtk.StackPage {
                name: "no-match";

                child: Adw.StatusPage {
                  icon-name: "edit-find-symbolic";
                  title: _("No Results Found");
                  description: _("Try a different search");

                  styles [
                    "compact",
                  ]
                };
              }
            };

            [bottom]
            Gtk.Label folder_truncated {
              visible: false;
              wrap: true;
              margin-start: 12;
              margin-end: 12;
              margin-top: 6;
              margin-bottom: 6;
              xalign: 0;

              styles [
                "caption",
                "dim-label",
              ]
            }
          };

          content: Adw.ToolbarView {
            reveal-top-bars: bind template.focus-mode inverted;
            reveal-bottom-bars: bind template.focus-mode inverted;

            [top]
            Adw.HeaderBar {
              [start]
              Gtk.ToggleButton sidebar_button {
                icon-name: "sidebar-show-symbolic";
                tooltip-text: _("Show Sidebar");
                action-name: "win.show-sidebar";
                visible: false;
              }

              [start]
              Gtk.Button {
                icon-name: "document-open-symbolic";
                tooltip-text: _("Open Document");
                action-name: "win.open";
              }

              [start]
              Gtk.Button {
                icon-name: "document-save-symbolic";
                tooltip-text: _("Save Document");
                action-name: "win.save";
              }

              title-widget: Adw.WindowTitle window_title {
                title: _("Untitled Document");
              };

              [end]
              Gtk.MenuButton {
                icon-name: "open-menu-symbolic";
                tooltip-text: _("Main Menu");
                menu-model: primary_menu;
                primary: true;
              }

              [end]
              Adw.TabButton tab_button {
                view: tab_view;
                action-name: "overview.open";
                visible: false;
              }

              [end]
              Adw.ToggleGroup view_toggles {
                notify::active-name => $on_view_toggled() swapped;

                Adw.Toggle {
                  name: "edit";
                  icon-name: "document-edit-symbolic";
                  tooltip: _("Edit Document");
                }

                Adw.Toggle {
                  name: "preview";
                  icon-name: "view-reveal-symbolic";
                  tooltip: _("Preview Document");
                }

                Adw.Toggle split_toggle {
                  name: "split";
                  icon-name: "view-dual-symbolic";
                  tooltip: _("Split View");
                }
              }

              [end]
              Gtk.MenuButton width_button {
                icon-name: "format-justify-fill-symbolic";
                tooltip-text: _("Content Width");
              }
            }

            // Shown once a window wide enough for it holds more than one document. Tabs are
            // dragged between windows here, and a tab dropped outside every window opens in a
            // new one.

            [top]
            Adw.TabBar tab_bar {
              view: tab_view;
            }

            content: Gtk.Stack content_stack {
              Gtk.StackPage {
                name: "documents";

                child: Adw.TabView tab_view {
                  menu-model: tab_menu;
                  // Not Ctrl+Home and Ctrl+End, with or without Shift: in the editor they move the
                  // cursor to the start and the end, and select up to them.
                  shortcuts: control_tab | control_shift_tab | control_page_up | control_page_down | control_shift_page_up | control_shift_page_down | alt_digits | alt_zero;
                  close-page => $on_close_page() swapped;
                  create-window => $on_create_window() swapped;
                  page-attached => $on_page_attached() swapped;
                  page-detached => $on_page_detached() swapped;
                  setup-menu => $on_setup_menu() swapped;
                  notify::selected-page => $on_selected_page() swapped;
                };
              }

              // A window with a folder stays open with no document.
              Gtk.StackPage {
                name: "no-document";

                child: Adw.StatusPage {
                  icon-name: "document-open-symbolic";
                  title: _("No Document Open");
                  description: _("Pick a file in the sidebar");
                };
              }
            };

            // The view toggles of a narrow window.

            [bottom]
            Gtk.ActionBar view_bar {
              visible: false;

              [center]
              Adw.ToggleGroup {
                active-name: bind view_toggles.active-name bidirectional;

                Adw.Toggle {
                  name: "edit";
                  icon-name: "document-edit-symbolic";
                  tooltip: _("Edit Document");
                }

                Adw.Toggle {
                  name: "preview";
                  icon-name: "view-reveal-symbolic";
                  tooltip: _("Preview Document");
                }

                Adw.Toggle bottom_split_toggle {
                  name: "split";
                  icon-name: "view-dual-symbolic";
                  tooltip: _("Split View");
                }
              }
            }
          };
        };
      };
    };

    [overlay]
    Gtk.Box drop_overlay {
      visible: false;
      can-target: false;

      styles [
        "drop-overlay",
      ]

      Adw.StatusPage {
        hexpand: true;
        icon-name: "document-open-symbolic";
        title: _("Drop Markdown file or folder to open");
      }
    }
  };
}
